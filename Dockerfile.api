FROM python:3.12-slim-bookworm

ARG APT_MIRROR=
ARG UV_INDEX=
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_INDEX_URL=${UV_INDEX} \
    PIP_INDEX_URL=${UV_INDEX}

WORKDIR /app

RUN if [ -n "$APT_MIRROR" ]; then \
        sed -i "s|deb.debian.org|$APT_MIRROR|g; s|security.debian.org|$APT_MIRROR|g" \
            /etc/apt/sources.list.d/debian.sources 2>/dev/null || \
        sed -i "s|deb.debian.org|$APT_MIRROR|g; s|security.debian.org|$APT_MIRROR|g" \
            /etc/apt/sources.list; \
    fi \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        fonts-noto-cjk \
        libharfbuzz-subset0 \
        libjpeg62-turbo \
        libopenjp2-7 \
        libpango-1.0-0 \
        libpangoft2-1.0-0 \
        shared-mime-info \
    && pip install --no-cache-dir uv \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

COPY alembic.ini ./
COPY alembic ./alembic
COPY configs ./configs
COPY knowledge ./knowledge
COPY scripts/upgrade_editorial_reports_v3.py ./scripts/upgrade_editorial_reports_v3.py
COPY scripts/upgrade_editorial_reports_v4.py ./scripts/upgrade_editorial_reports_v4.py
COPY scripts/create_initial_admin.py ./scripts/create_initial_admin.py
COPY scripts/reset_admin_mfa.py ./scripts/reset_admin_mfa.py
COPY scripts/check_production_readiness.py ./scripts/check_production_readiness.py
COPY scripts/cleanup_retention.py ./scripts/cleanup_retention.py
COPY src ./src

RUN uv sync --frozen --no-dev \
    && useradd --create-home --uid 10001 app \
    && mkdir -p /app/data \
    && chown -R app:app /app/data \
    && chmod -R a+rX /app

USER app
ENV PATH="/app/.venv/bin:${PATH}"

EXPOSE 8000

CMD ["uvicorn", "src.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
