APP_DOMAIN=review.example.com
APP_ENV=production
PUBLIC_BASE_URL=https://review.example.com
POSTGRES_DB=socialeval
POSTGRES_USER=socialeval
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://socialeval:replace-with-url-encoded-password@postgres:5432/socialeval
REDIS_URL=redis://redis:6379/0
SECRET_KEY=replace-with-at-least-32-random-bytes
ALLOWED_ORIGINS=https://review.example.com
ALLOWED_HOSTS=review.example.com
SESSION_HTTPS_ONLY=true

# 仅填写获授权使用的模型供应商凭据。
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
FUCHEERS_API_KEY=
FUCHEERS_BASE_URL=https://api.fucheers.ai/v1

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
SMTP_FROM_NAME=文科论文智能辅助评审系统
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_TIMEOUT=10
EMAIL_ENABLED=true
UPLOAD_MAX_BYTES=31457280
TASK_STALE_SECONDS=600
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900
