# 复制到 /etc/socialeval/backup.env，权限设为 root:root 0600。
SOCIALEVAL_DEPLOY_DIR=/opt/socialeval
SOCIALEVAL_ENV_FILE=/opt/socialeval/.env.production
SOCIALEVAL_DATA_ROOT=/srv/socialeval
POSTGRES_DB=socialeval
POSTGRES_USER=socialeval

# 交大云私有 S3 存储空间。Restic 会在客户端加密后再上传。
RESTIC_REPOSITORY=s3:https://s3.jcloud.sjtu.edu.cn/socialeval-backup
RESTIC_PASSWORD_FILE=/etc/socialeval/restic-password
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
